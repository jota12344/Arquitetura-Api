APP_NAME=ArquiteturaAPI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082

# Ajuste com id -u e id -g no Linux/WSL.
WWWUSER=1000
WWWGROUP=1000
APP_PORT=8082
FORWARD_DB_PORT=3307

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
# Preencha somente no .env local, antes de iniciar o Docker.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Não há servidor SMTP no Compose. Mensagens locais vão para o log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
